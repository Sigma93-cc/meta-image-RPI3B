From 51f5145ae7729a5778c2cc790192e172c4a6ad95 Mon Sep 17 00:00:00 2001
From: SigovAS <SigovAS@pay-trans.ru>
Date: Wed, 14 Oct 2026 14:18:29 +0300
Subject: [PATCH] rpi: SigmaOS A/B boot env and writeable list

Upstream-Status: Inappropriate [product-specific]
---
 board/raspberrypi/rpi/rpi.env | 29 +++++++++++++++++++++++++++++
 include/configs/rpi.h         |  3 +++
 2 files changed, 32 insertions(+)

diff --git a/board/raspberrypi/rpi/rpi.env b/board/raspberrypi/rpi/rpi.env
index 30228285edd..2b53eb8247c 100644
--- a/board/raspberrypi/rpi/rpi.env
+++ b/board/raspberrypi/rpi/rpi.env
@@ -75,3 +75,32 @@ fdt_addr_r=0x02600000
 ramdisk_addr_r=0x02700000
 
 boot_targets=mmc usb pxe dhcp
+
+bootpart=2
+update_part=3
+bootcount=0
+upgrade_available=0
+
+sigma_boot=
+	echo "--> Booting slot ${bootpart} (upgrade_available=${upgrade_available}, bootcount=${bootcount})";
+	setenv bootargs "coherent_pool=1M 8250.nr_uarts=1 cgroup_disable=memory vc_mem.mem_base=0x3ec00000 vc_mem.mem_size=0x40000000 dwc_otg.lpm_enable=0 console=ttyAMA0,115200 root=/dev/mmcblk0p${bootpart} rootfstype=ext4 rootwait logo.nologo net.ifnames=0 systemd.machine_id=0000000000005569${serial#} panic=5 watchdog.open_timeout=180 ro";
+	if ext4load mmc 0:${bootpart} ${kernel_addr_r} /boot/Image; then
+		booti ${kernel_addr_r} - ${fdt_addr};
+	fi;
+	echo "<-- Kernel load/start failed on slot ${bootpart}";
+	setenv upgrade_available 1;
+	saveenv;
+	reset
+
+sigma_rollback=
+	echo "<-- Bootlimit exceeded, rolling back from slot ${bootpart}";
+	setenv t ${bootpart};
+	setenv bootpart ${update_part};
+	setenv update_part ${t};
+	setenv t;
+	setenv upgrade_available 0;
+	setenv bootcount 0;
+	saveenv;
+	run sigma_boot
+
+altbootcmd=run sigma_rollback; reset
diff --git a/include/configs/rpi.h b/include/configs/rpi.h
index 8e56bdc84a8..2f7d84975d2 100644
--- a/include/configs/rpi.h
+++ b/include/configs/rpi.h
@@ -31,4 +31,7 @@
  */
 #define CFG_SYS_SDRAM_SIZE		SZ_128M
 
+#define CFG_ENV_FLAGS_LIST_STATIC \
+	"bootpart:dw,update_part:dw,bootcount:dw,upgrade_available:dw,bootstopkeycrypt:sw"
+
 #endif
-- 
