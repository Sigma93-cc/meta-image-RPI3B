# Set defaults if not yet present in env
test -n "${bootpart}" || setenv bootpart 2
test -n "${update_part}" || setenv update_part 3
test -n "${bootcount}" || setenv bootcount 0
test -n "${upgrade_available}" || setenv upgrade_available 0
test -n "${bootlimit}" || setenv bootlimit 3

echo "--> Welcome to device: ${serial#}"
if test ! -n "${env_ok}"; then
    setenv env_ok 1
    saveenv
fi

echo "--> Checking upgrades"
if test ${upgrade_available} -eq 1; then
    if test ${bootcount} -ge ${bootlimit}; then 
        setenv cur_bootpart ${bootpart}
        setenv bootpart ${update_part}
        setenv update_part ${cur_bootpart}
        setenv upgrade_available 0
        setenv bootcount 0
        setenv cur_bootpart
        saveenv
        echo "<-- UpgradeFailed,set activepart=${bootpart}"
    else         
        setexpr bootcount ${bootcount} + 1        
        saveenv
        echo "<-- UpgradeAvailable check, set bootcount=${bootcount} activepart=${bootpart}"
    fi
else
    echo "<-- UpgradeNotAvailable, run activepart=${bootpart}"
fi


setenv machine_id 0000000000005569${serial#}
echo "--> Setting machineid: ${machine_id}"

# Use firmware-supplied FDT
fdt addr ${fdt_addr}

# Build bootargs with parameterized root
setenv bootargs "coherent_pool=1M 8250.nr_uarts=1 cgroup_disable=memory vc_mem.mem_base=0x3ec00000 vc_mem.mem_size=0x40000000 dwc_otg.lpm_enable=0 console=ttyAMA0,115200 root=/dev/mmcblk0p${bootpart} rootfstype=ext4 rootwait logo.nologo net.ifnames=0 systemd.machine_id=${machine_id} ro"
setenv machine_id
# Load and boot kernel
fatload @@BOOT_MEDIA@@ 0:1 ${kernel_addr_r} @@KERNEL_IMAGETYPE@@
@@KERNEL_BOOTCMD@@ ${kernel_addr_r} - ${fdt_addr}