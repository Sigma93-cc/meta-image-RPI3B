# Set defaults if not yet present in env
test -n "${bootslot}" || setenv bootslot b
test -n "${bootcount}" || setenv bootcount 0
test -n "${upgrade_available}" || setenv upgrade_available 0
test -n "${bootlimit}" || setenv bootlimit 3

# A/B slot selection
if test "${bootslot}" = "a"; then
    setenv mmcpart 2
else
    setenv mmcpart 3
fi

# Use firmware-supplied FDT
fdt addr ${fdt_addr}

# Build bootargs with parameterized root
setenv bootargs "coherent_pool=1M 8250.nr_uarts=1 cgroup_disable=memory vc_mem.mem_base=0x3ec00000 vc_mem.mem_size=0x40000000 dwc_otg.lpm_enable=0 console=ttyAMA0,115200 root=/dev/mmcblk0p${mmcpart} rootfstype=ext4 rootwait logo.nologo net.ifnames=0"

# Save env on first boot
if test ! -e @@BOOT_MEDIA@@ 0:1 uboot.env; then saveenv; fi

# Load and boot kernel
fatload @@BOOT_MEDIA@@ 0:1 ${kernel_addr_r} @@KERNEL_IMAGETYPE@@
@@KERNEL_BOOTCMD@@ ${kernel_addr_r} - ${fdt_addr}